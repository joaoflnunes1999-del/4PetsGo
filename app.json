{
  "expo": {
    "name": "4PetsGo",
    "slug": "4petsgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fourpetsgo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.fourpetsgo.app",
      "supportsTablet": false,
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F2EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fourpetsgo.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F2EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "4PetsGo accède à vos photos pour que vous puissiez ajouter des souvenirs à la galerie de votre animal et choisir sa photo de profil.",
          "cameraPermission": "4PetsGo utilise l’appareil photo pour photographier votre animal et l’ajouter directement à sa galerie.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
